        "verdict": {
          "approved": false,
          "summary": "The current head adds useful revision evidence but does not satisfy the zero-diff reconciliation contract and leaves the new ancestry evidence unbounded.",
          "findingsComplete": true,
          "blockingFindings": [
            {
              "id": "df-dd22f9ca250d873a92c8",
              "title": "Zero-diff reconciliation still requires model review rounds",
              "details": "For a trusted release-engine PR with an empty exact changed-path inventory, createPullRequestTarget still returns a normal review target and executeAutoreview unconditionally invokes runAutoreview. The new revision facts only inform those model rounds; they do not implement a trusted zero-diff admission or approval path. Consequently a valid reconciliation PR can still be blocked by unavailable model routes, contrary to issue #280's requirement that trusted zero-diff automation complete without model rounds. There is also no end-to-end test exercising an empty inventory through this path.",
              "path": ".github/scripts/run-darkfactory-autoreview.mjs",
              "line": null
            },
            {
              "id": "df-1a84d338a39af19c291b",
              "title": "Commit-parent evidence is not actually bounded",
              "details": "FIRST_PARENT_PROOF_LIMIT bounds the number of visited commits, but parseExactCommitRecord accepts an unlimited number of parents and the code serializes every parent into a verified-fact string. A head-controlled octopus merge can therefore expand ancestry evidence up to the Git subprocess buffer and bypass the bounded target-context serialization, causing prompt-size or route failures. Bound parent count and total serialized evidence length and fail closed, with coverage for the limit.",
              "path": ".github/scripts/run-darkfactory-autoreview.mjs",
              "line": null
            }
          ],
          "nonBlockingNotes": []
        },
