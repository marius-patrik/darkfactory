    "verdict": {
      "approved": false,
      "summary": "The exact two-file diff was fully inspected. One blocking trust-boundary gap remains: configurable policy checks can still be satisfied without trusted workflow provenance.",
      "findingsComplete": true,
      "blockingFindings": [
        {
          "id": "df-b1efa7717de77cf3c0fd",
          "title": "Policy-selected custom checks bypass workflow provenance binding",
          "details": "When a policy-selected check name is absent from TRUSTED_POLICY_WORKFLOWS, bindTrustedPolicyCheckRuns passes it through unchanged. evaluateRequiredChecks can then mark it green using only its name, Actions App ID, and conclusion. Release policy permits arbitrary requiredChecks, mainChecks, artifactWorkflows, and publicationChecks, so a head-controlled GitHub Actions workflow with a colliding check name can satisfy such a gate. Fail closed for unmapped policy checks or require a base-trusted workflow binding for every policy-selected Actions check. The added test that accepts an unbound \"Artifact Scan\" should instead cover rejection or verified provenance.",
          "path": ".github/scripts/df-release.mjs",
          "line": 435
        }
      ],
      "nonBlockingNotes": [
        "The independent exact-head Validate gate owns command-execution evidence; no missing-execution finding was created."
      ]
    },
