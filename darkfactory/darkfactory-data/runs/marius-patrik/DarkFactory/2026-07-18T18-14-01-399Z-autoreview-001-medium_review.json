    "verdict": {
      "approved": false,
      "summary": "Complete review found one trust-boundary defect: malformed ancestry evidence is converted into an optional bounded-out result instead of blocking closed.",
      "findingsComplete": true,
      "blockingFindings": [
        {
          "id": "df-359ec4147620a9442f8d",
          "title": "Malformed ancestry evidence is silently downgraded",
          "details": "The catch handles every target_policy_blocked error from ancestry collection by setting ancestryBoundedOut=true and continuing. This includes invalid object IDs, duplicate or self parents, a commit record that does not match the requested commit, and cyclic evidence. The resulting strings are then published as verified facts and the review proceeds, contrary to the fail-closed requirement for malformed evidence. Only expected size/depth exhaustion should be represented as bounded supplemental evidence; structural or relationship validation failures must propagate and block admission. Add regression coverage distinguishing legitimate bounding from malformed ancestry.",
          "path": ".github/scripts/run-darkfactory-autoreview.mjs",
          "line": 785
        }
      ],
      "nonBlockingNotes": []
    },
    "findings": [
      {
        "id": "df-359ec4147620a9442f8d",
        "title": "Malformed ancestry evidence is silently downgraded",
        "details": "The catch handles every target_policy_blocked error from ancestry collection by setting ancestryBoundedOut=true and continuing. This includes invalid object IDs, duplicate or self parents, a commit record that does not match the requested commit, and cyclic evidence. The resulting strings are then published as verified facts and the review proceeds, contrary to the fail-closed requirement for malformed evidence. Only expected size/depth exhaustion should be represented as bounded supplemental evidence; structural or relationship validation failures must propagate and block admission. Add regression coverage distinguishing legitimate bounding from malformed ancestry.",
