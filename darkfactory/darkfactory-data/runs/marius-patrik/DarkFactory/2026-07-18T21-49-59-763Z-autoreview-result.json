        "verdict": {
          "approved": false,
          "summary": "Complete review of marius-patrik/DarkFactory PR #400 at head e228e5fd9a5eaa003e93bb2571a8309a717b08f4 found one blocking ordinary-PR regression in release-marker detection.",
          "findingsComplete": true,
          "blockingFindings": [
            {
              "id": "df-6659e6a5c7da34f5018d",
              "title": "Release marker detection rejects ordinary prose mentions",
              "details": "releaseIssueNumbers first selects every body line containing the substring `darkfactory:release-issues`, then requires that entire line to be the exact HTML marker. Consequently, an ordinary PR that merely documents or discusses the marker—while retaining a valid closing-issue link—fails with target_policy_blocked. This violates the acceptance requirement to preserve ordinary PR linked-issue behavior and can make marker-related maintenance PRs unreviewable. Restrict malformed-marker rejection to syntactic marker candidates and add a regression proving that a prose mention plus `Closes #N` remains admitted while malformed actual marker comments remain blocked.",
              "path": ".github/scripts/run-darkfactory-autoreview.mjs",
              "line": 429
            }
          ],
          "nonBlockingNotes": []
        },
        "findings": [
