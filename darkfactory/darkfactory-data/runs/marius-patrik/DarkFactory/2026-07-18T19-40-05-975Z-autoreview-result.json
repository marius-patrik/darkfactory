          "blockingFindings": [
            {
              "id": "df-ff63897ea97a4ffd6f77",
              "title": "Reject multi-line commit ancestry records",
              "details": "parseExactCommitRecord collapses all whitespace with split(/\\s+/), so malformed output containing multiple rev-list records is accepted as one commit with additional parents when the object IDs are unique. The resulting verified fact can therefore misrepresent unrelated commits as parents instead of failing closed, violating issue #369's malformed-ancestry acceptance criterion. Require exactly one ancestry record before parsing its commit and parent fields.",
              "path": ".github/scripts/run-darkfactory-autoreview.mjs",
              "line": 665
            }
          ],
