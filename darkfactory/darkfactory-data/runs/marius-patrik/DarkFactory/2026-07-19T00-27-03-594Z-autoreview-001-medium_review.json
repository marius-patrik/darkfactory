    "verdict": {
      "approved": false,
      "summary": "PR #427 is blocked by a workflow-provenance bypass: ordinary workflow-run paths are accepted without proving the run used an allowed trusted ref.",
      "findingsComplete": true,
      "blockingFindings": [
        {
          "id": "df-20802100fe4771275148",
          "title": "Workflow runs without an embedded ref bypass the trusted-ref allowlist",
          "details": "isTrustedWorkflowPath returns true when the workflow-run path contains no @ref suffix. GitHub workflow-run evidence commonly represents path separately from the triggering ref, so a push or workflow_dispatch run using a head-controlled version of the expected workflow path can satisfy this binding solely through matching path, event, head SHA, and suite ID. This is especially exploitable because push and workflow_dispatch are explicitly allowed events. Validate the run's independently reported branch/ref and repository provenance against the configured allowlist, include those fields in consistency fingerprints, and fail closed when trusted-ref provenance is absent.",
          "path": ".github/scripts/df-release.mjs",
          "line": 852
        }
      ],
      "nonBlockingNotes": [
        "The pagination logic otherwise covers declared totals, truncated pages, duplicate IDs, bounded inventories, and two-pass mutation detection.",
        "The added tests exercise late-page evidence and several malformed or spoofed workflow cases, but do not cover a matching plain path originating from a disallowed ref.",
        "Execution evidence remains owned by the independent exact-head Validate gate."
      ]
    },
    "findings": [
