    "findings": [
      {
        "id": "df-4c123cc70feaaf4369f0",
        "title": "Independent-gate language leaks into non-review profiles",
        "details": "The shared validation-autoreview skill tells every consuming profile that the separate Validate gate owns execution evidence and that omitted results are acceptable. Implementer, PR-fixer, pointer-updater, releaser, and issue-drafter profiles also consume this skill, contradicting the acceptance criterion that non-review profiles retain normal validation duties. Scoping only renderValidation() does not remove the conflicting shared instructions visible in their composed prompts.",
        "path": "prompts/skills/validation-autoreview.md",
        "line": 7
      },
      {
        "id": "df-48055238ea3611de528d",
        "title": "Required gitlink transition regressions are incomplete",
        "details": "The focused tests cover addition, deletion, and gitlink-to-blob replacement, but do not exercise a base/head gitlink pointer change or rename through the changed-path indexing and autofix-file construction path. Those are explicitly required trust-boundary cases, so the current tests do not prove that exact OIDs and paths survive those transitions or that renamed/pointer-changed gitlinks remain excluded from autofix.",
        "path": "tests/df-autoreview.test.ts",
        "line": 143
      }
    ],
