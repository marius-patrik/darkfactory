    "findings": [
      {
        "id": "df-b39d3aa03be80430a1b7",
        "title": "PR fixer still claims mutation responsibilities",
        "details": "The role now calls itself a proposal-only, read-only fixer, but earlier bullets still instruct it to re-verify before every write and push a follow-up commit. Those instructions contradict the trusted runtime boundary and the updated validation skill. Remove mutation responsibilities from the model role and state that the trusted runtime owns revalidation, application, commit, and push.",
        "path": "prompts/roles/pr-fixer.md",
        "line": 8
      },
      {
        "id": "df-88d9419d73d177dbfccf",
        "title": "Release review-context fetching lacks regression coverage",
        "details": "The added regression exercises assertPullPolicy and proves marker parsing returns issue numbers, but it never exercises createPullRequestTarget to prove those issue contracts are fetched and serialized into linkedIssues as untrusted review context. This leaves the acceptance criterion that specifically requests parser/context regressions uncovered; add a bounded target-context test covering successful inclusion and fetch rejection behavior.",
        "path": "tests/df-autoreview.test.ts",
        "line": 688
      }
    ],
