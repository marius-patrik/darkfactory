    "verdict": {
      "approved": false,
      "summary": "The exact PR #422 head has one blocking correctness issue in required-check collision handling.",
      "findingsComplete": true,
      "blockingFindings": [
        {
          "id": "df-af5a13a65a4ecdec1c10",
          "title": "Same-App check collisions can select stale green evidence",
          "details": "At head 54835358677cb6c3f5e519fbce9267350b3f3bfb, evaluateRequiredChecks collects every same-name check run but selects the first candidate matching expectedAppId. The check-runs response can contain matching-name runs from multiple check suites, and this code establishes no ordering or freshness invariant. A stale green Actions run can therefore be selected while another same-App candidate is pending or red, incorrectly reporting the gate green during release verification. The added tests cover collisions between different App IDs but not multiple candidates from the required App. Select authoritative current evidence deterministically or fail closed on ambiguous matching candidates, and add green/red/pending same-App collision coverage.",
          "path": ".github/scripts/df-release.mjs",
          "line": 178
        }
      ],
      "nonBlockingNotes": [
        "The main-evidence helper correctly limits post-release evaluation to policy-selected checks instead of inheriting unrelated protected-branch checks.",
        "The external App-bound check tests cover both response orderings when only one candidate belongs to the required App."
      ]
    },
    "findings": [
      {
