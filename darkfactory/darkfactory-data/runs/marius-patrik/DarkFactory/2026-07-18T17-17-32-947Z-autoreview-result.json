        "verdict": {
          "approved": false,
          "summary": "The zero-diff bypass does not fail closed on incomplete ancestry evidence, and its new verdict is incorrectly accepted by the issue-completion path.",
          "findingsComplete": true,
          "blockingFindings": [
            {
              "id": "df-4faf75edb9b16afb2e11",
              "title": "Malformed or incomplete first-parent evidence still grants the bypass",
              "details": "trustedPullRevisionEvidence catches target_policy_blocked ancestry failures and converts them to ancestryBoundedOut=true, but isTrustedZeroDiffReconciliation ignores reachedBase, complete, and ancestryBoundedOut. Consequently malformed, truncated, or non-first-parent ancestry can receive trusted_zero_diff, while the published comment falsely states that complete first-parent ancestry was proved. Require reachedBase=true, complete=true, and ancestryBoundedOut=false, or remove that proof claim and explicitly justify the weaker admission contract.",
              "path": ".github/scripts/run-darkfactory-autoreview.mjs",
              "line": 1313
            },
            {
              "id": "df-17b5adadc1fe47cca56f",
              "title": "PR-only zero-diff verdict is accepted as issue completion",
              "details": "SUCCESSFUL_RESULT_VERDICTS is consumed by reconcileExactIssueCompletion, which operates exclusively on issues. Adding trusted_zero_diff allows a PR-specific verdict to apply df:reviewed to an issue without medium/high review or an owner override. Result classification is not kind-bound, so semantically malformed trusted-bot evidence is accepted instead of failing closed. Keep trusted_zero_diff out of the issue-success set and handle it only in the exact PR recovery path.",
              "path": ".github/scripts/run-darkfactory-autoreview.mjs",
              "line": 59
            }
          ],
          "nonBlockingNotes": []
        },
        "findings": [
