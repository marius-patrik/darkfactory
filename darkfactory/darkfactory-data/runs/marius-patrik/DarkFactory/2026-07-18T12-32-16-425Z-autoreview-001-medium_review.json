      "approved": false,
      "summary": "The complete review of head 73f80063c323fcce0dff1eff6729d8f3906c1c63 found one blocking gitlink-evidence defect.",
      "findingsComplete": true,
      "blockingFindings": [
        {
          "id": "df-220db7fb5cc83aef94e2",
          "title": "Gitlink-to-blob transitions emit an inconsistent pointer record",
          "details": "When the base entry is a 160000 gitlink but the head entry is a blob, classifyChangedTreeEntry enters the gitlink branch yet prefers the head entry for mode and oid. The resulting reviewed-file record has kind \"gitlink\" but mode \"100644\" and the blob OID, while the actual gitlink OID appears only in baseOid. This violates issue #343's requirement that changed gitlinks be serialized as exact 160000 pointer records with their object IDs and gives consumers contradictory type evidence. Preserve the gitlink's 160000 mode and commit OID in the pointer record and carry replacement-blob metadata separately, with a regression asserting the complete transition record.",
          "path": ".github/scripts/run-darkfactory-autoreview.mjs",
          "line": 590
        }
      ],
      "nonBlockingNotes": []
    },
    "findings": [
      {
        "id": "df-220db7fb5cc83aef94e2",
        "title": "Gitlink-to-blob transitions emit an inconsistent pointer record",
        "details": "When the base entry is a 160000 gitlink but the head entry is a blob, classifyChangedTreeEntry enters the gitlink branch yet prefers the head entry for mode and oid. The resulting reviewed-file record has kind \"gitlink\" but mode \"100644\" and the blob OID, while the actual gitlink OID appears only in baseOid. This violates issue #343's requirement that changed gitlinks be serialized as exact 160000 pointer records with their object IDs and gives consumers contradictory type evidence. Preserve the gitlink's 160000 mode and commit OID in the pointer record and carry replacement-blob metadata separately, with a regression asserting the complete transition record.",
        "path": ".github/scripts/run-darkfactory-autoreview.mjs",
        "line": 590
      }
