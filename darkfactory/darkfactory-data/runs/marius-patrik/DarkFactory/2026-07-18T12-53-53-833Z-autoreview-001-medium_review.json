    "verdict": {
      "approved": false,
      "summary": "Review of marius-patrik/DarkFactory PR #353 at head 903cbc4e277d3aaa975cc3fc55d4e59a676f66f3 found two blocking gaps: the privileged diff check does not explicitly disable external diff/text-conversion helpers, and no trusted exact-head required-check evidence was supplied.",
      "findingsComplete": true,
      "blockingFindings": [
        {
          "id": "df-049fd648fe0f10145065",
          "title": "Disable external helpers during the privileged diff check",
          "details": "verifyExactPullDiff invokes `git diff --check` without `--no-ext-diff` and `--no-textconv`, although the controller inherits Git-related environment and target-controlled attributes can select configured conversion or diff drivers. This does not prove the required no-execution trust boundary. Invoke the exact-ref check with both helpers explicitly disabled and extend the regression to assert those immutable arguments.",
          "path": ".github/scripts/run-darkfactory-autoreview.mjs",
          "line": 632
        },
        {
          "id": "df-33bf0cc647a2c86fb80a",
          "title": "Trusted exact-head required-check provenance is missing",
          "details": "For head 903cbc4e277d3aaa975cc3fc55d4e59a676f66f3, the supplied verified state proves only target identity and default branch. It provides no trusted result for `npm run check` or the required Validate and DarkFactory Autoreview contexts. Under the current trusted review contract, missing exact-revision gate evidence blocks approval until supplied by the independent validation/control lane.",
          "path": null,
          "line": null
        }
      ],
      "nonBlockingNotes": []
    },
    "findings": [
      {
