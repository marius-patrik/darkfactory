    "verdict": {
      "approved": false,
      "summary": "The external-App binding change is incomplete because check runs are still deduplicated by context alone, so valid required evidence can be discarded when another App publishes the same check name.",
      "findingsComplete": true,
      "blockingFindings": [
        {
          "id": "df-f6af532b9eeec752c2d0",
          "title": "App-bound checks are resolved by name instead of name and App",
          "details": "`latest` retains only the first check run for each name before the expected App binding is evaluated. If a required external check from App 999 is green but another App has a same-named run earlier in the API response, the valid App-999 evidence is discarded and the requirement is reported red. GitHub protection bindings distinguish checks by context and App, so lookup must preserve/select the run matching the required App; add collision coverage with green expected-App and same-named wrong-App runs in both response orders.",
          "path": ".github/scripts/df-release.mjs",
          "line": 155
        }
      ],
      "nonBlockingNotes": []
    },
