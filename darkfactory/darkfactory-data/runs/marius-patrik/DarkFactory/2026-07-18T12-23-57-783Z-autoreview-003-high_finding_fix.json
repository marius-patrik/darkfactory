    "findings": [
      {
        "id": "df-f6a6be8e4b46c11f1154",
        "title": "Deleted gitlinks remain eligible for autofix replacement",
        "details": "changedPullFiles indexes only the head tree. When a gitlink is deleted or is the source of a rename, the absent head entry is serialized as a generic deletion with null mode and OID. Because the path is also omitted from snapshot.files, an autofix proposal can treat it as a new zero-hash text path; after checking out the head, the deleted path is absent and the fixer can recreate it as a regular file. This violates issue #343's requirements that every changed gitlink retain mode 160000 and its object ID and never be admitted to autofix. Classify deletions against the base tree and explicitly exclude every base-or-head gitlink path from autofix admission, with regressions for deleted and renamed gitlinks.",
        "path": ".github/scripts/run-darkfactory-autoreview.mjs",
        "line": null
      },
      {
        "id": "df-393bba029b9d901670d3",
        "title": "Required exact-head review and validation provenance is missing",
        "details": "Trusted state for marius-patrik/DarkFactory PR #353 at head b2bab2457291995c15d348ca506fefa135aa2852 verifies only that the target is open and names the default branch. It supplies neither a clean medium-tier round nor a trusted exact-head Validate result for npm run check. The PR-body validation claims are untrusted and cannot satisfy these gates, so the high-tier final review cannot approve this revision.",
        "path": null,
        "line": null
      }
