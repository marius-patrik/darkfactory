        "verdict": {
          "approved": false,
          "summary": "The zero-diff admission proof is technically sound, but the exact decision evidence is discarded before publication and recovery misclassifies one new successful state.",
          "findingsComplete": true,
          "blockingFindings": [
            {
              "id": "df-7aff4dd1d096db5350c6",
              "title": "Zero-diff approval drops its trusted revision evidence",
              "details": "For marius-patrik/DarkFactory#363 at head a8736762e104a91349a2553afbba79a81c8b00dc, trustedZeroDiffResult retains only the target version, state, and empty rounds. executeAutoreview consequently persists no exact base/head trees, merge base, changed-path count/digest, or engine-provenance evidence, while the result comment merely claims those checks succeeded. The model-free approval therefore lacks a durable evidence trace for the facts that authorized it. Carry the exact revalidated proof and trusted actor decision into the published ledger evidence before treating this state as successful.",
              "path": ".github/scripts/run-darkfactory-autoreview.mjs",
              "line": 1324
            },
            {
              "id": "df-b816c1107ba60f22febc",
              "title": "Recovery misreports a trusted zero-diff result when its gate is red",
              "details": "The red-gate recovery path recognizes only clean and owner_override when selecting the successful-comment-with-red-gate reason. A trusted_zero_diff completion is therefore recorded as missing-or-stale-result even though the exact successful comment was observed. The rerun action is correct, but its durable operational evidence is false. Use isSuccessfulPullCompletion here and add the corresponding red-gate regression case.",
              "path": ".github/scripts/df-autoreview-recovery.mjs",
              "line": 207
            }
          ],
          "nonBlockingNotes": []
        },
