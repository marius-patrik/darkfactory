    "verdict": null,
    "findings": [
      {
        "id": "df-09d91182f52ef29fd0de",
        "title": "Package-metadata authority and layering are undefined",
        "details": "The requirement for “one authoritative package.json surface” does not identify the authoritative file, enumerate fields owned at the root versus package level, define permitted package-local metadata, or specify how conflicting values are resolved. A worker cannot determine the intended end state without making semantic owner decisions.",
        "path": null,
        "line": null
      },
      {
        "id": "df-d723956976378d0f310b",
        "title": "Documentation scope and disposition are not specified",
        "details": "The issue provides no inventory of affected root or package documents, no per-document keep, relocate, redirect, retire, or remove disposition, and no exact PRD.md/PLAN.md precedence wording. Deciding which documents compete with authority or may be removed is ambiguous and potentially destructive.",
        "path": null,
        "line": null
      },
      {
        "id": "df-b6620b9f0711c51b46ea",
        "title": "Dependency and residual-scope claims are unverifiable",
        "details": "The contract depends on work attributed to #179 and claims to replace #178, but it identifies no verified #179 revision or delivered-state evidence and does not map every #178 requirement to completed, retained, or residual scope. The available state therefore cannot establish prerequisites, prevent omissions, or rule out duplicated work.",
        "path": null,
        "line": null
      },
      {
        "id": "df-a8995856b5bd55bb85ef",
        "title": "Single-lane ownership and boundaries are unclear",
        "details": "“PLAN lane 2” does not define the lane owner, the exact files or repository surfaces it owns, or its boundary against repository-authority, package-layout, validation, and documentation work. The contract cannot safely assign one implementation lane or adjudicate overlaps.",
        "path": null,
        "line": null
      },
      {
        "id": "df-73ef6f5948cd7990ff68",
        "title": "Acceptance criteria are subjective and not evidentiary",
        "details": "Terms such as “internally consistent,” “remaining root documentation,” and “no stale competing authority” are not expressed as objective assertions over named files, metadata fields, references, or repository searches. The issue also does not state what reviewable evidence proves each acceptance condition.",
        "path": null,
        "line": null
      },
      {
        "id": "df-37aa8081fc78e4c05ec8",
        "title": "Failure, compatibility, migration, and rollout behavior are missing",
        "details": "The issue does not say how to fail closed when metadata or document authority is ambiguous, whether package consumers or published artifacts require compatibility handling, how moved or retired documentation remains discoverable, or how the consolidation is rolled out and reverted. These choices must be resolved before implementation.",
        "path": null,
        "line": null
      }
    ],
