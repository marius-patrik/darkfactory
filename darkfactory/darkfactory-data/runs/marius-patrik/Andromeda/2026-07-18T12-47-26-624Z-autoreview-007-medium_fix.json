    "findings": [
      {
        "id": "df-ab107c7a36a41105f993",
        "title": "Route states and normalized outcomes lack one exhaustive state machine",
        "details": "The contract alternates between `disabled` as a route status and phrases such as \"disabled as quota_blocked\", \"disabled as credential_missing\", and \"disabled as decommissioned\", while the schema status enumeration treats those reason codes as distinct statuses. No separate enabled flag or reason field is required. Rollback likewise selects an unspecified \"disabled or blocked status\", and no normalized successful-proof outcome is defined. Specify exhaustive status and outcome enums plus the exact before/after transition for every admission, failure, rollback, and required provider terminal state.",
        "path": null,
        "line": null
      },
      {
        "id": "df-3c913d7b64fcb6659f8b",
        "title": "Observation evidence does not fully define the data needed to reproduce promotion and rollback",
        "details": "Promotion compares route-configuration and credential-state digests, while rollback depends on an immutable route tuple, checkpoint series, and counter resets. These fields and their representations are not explicitly required by the admission-record field list or authoritative schema contract. The credential-state digest derivation is also undefined, so implementations could expose a credential-derived hash, change identity on refresh, or produce incompatible values. Require schema fields for the complete immutable tuple, series/checkpoint identity, T0, counter inputs and resets, and define a canonical non-secret credential-state attestation produced by the credential owner.",
        "path": null,
        "line": null
      }
    ],
    "findingIds": [
      "df-ab107c7a36a41105f993",
