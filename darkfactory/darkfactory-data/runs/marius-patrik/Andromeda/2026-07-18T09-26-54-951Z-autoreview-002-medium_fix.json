    "findings": [
      {
        "id": "df-000d205771a13f148a94",
        "title": "Managed-package validation does not prove indexed direct lowercase gitlinks",
        "details": "At the reviewed head, packageGitlinks is derived only from .gitmodules declarations. It is never reconciled with stage-0 entries from indexedGitlinks, duplicate declarations and conflicted stages are not rejected, and paths are not constrained to lowercase direct children of packages/. Consequently, a classified ordinary directory with a matching declaration, an ambiguous duplicate declaration, or a nested or uppercase managed path can pass. This violates issue #301's gitlink layout and fail-closed validation criteria. Require exactly one matching stage-0 index gitlink and declaration for each classified managed package, enforce the direct-lowercase path shape, and add denied regression cases.",
        "path": "scripts/verify-test-inventory.mjs",
        "line": 115
      },
      {
        "id": "df-eea4bcd1b5d11a16f3f6",
        "title": "Required validation and submodule provenance are absent",
        "details": "Trusted evidence verifies only that marius-patrik/Andromeda PR #300 is open at 4739cf8f38191f0879952db04ef4c9a9e9d7ead9:11a543ce8d7ef7ef4816e710873ef06e25f18361. It supplies no trusted result for git diff --check or git submodule status --recursive, and no fresh-clone initialization, child accessibility, released-default-branch ancestry, or green child evidence for the six moved pointers. Claims in the untrusted PR body cannot satisfy these gates. Validation and pointer-contract evidence must be recorded for this exact head before approval.",
        "path": null,
        "line": null
      }
