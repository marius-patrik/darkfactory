    "findings": [
      {
        "id": "df-de4b7e9d1f4c1fc4f535",
        "title": "Authoritative metadata ownership and layering are undefined",
        "details": "The requirement for one authoritative root package.json and consistent package-local metadata does not identify which fields belong at the root, which may remain package-local, how conflicting values are resolved, or which packages and metadata surfaces are in scope. This prevents single-lane implementation and objective review without an owner-approved field and layering contract.",
        "path": null,
        "line": null
      },
      {
        "id": "df-9001f348f9dfcec4808b",
        "title": "Documentation scope and authority dispositions are unspecified",
        "details": "The issue does not inventory the affected root and package documentation, state the required keep, relocate, retire, or remove disposition for each artifact, or provide the exact PRD.md and PLAN.md precedence wording. Determining which documents compete with authority is a semantic and potentially destructive owner decision.",
        "path": null,
        "line": null
      },
      {
        "id": "df-72575d9927cc3421200e",
        "title": "Dependencies and inherited scope are unverifiable",
        "details": "The issue says it replaces closed issue #178 and follows #179, but it does not identify the verified #179 revision or map every inherited #178 requirement to completed evidence or remaining work. Trusted policy forbids silently treating prior work as superseded, so dependencies, residual scope, and single-lane ownership cannot be established.",
        "path": null,
        "line": null
      },
      {
        "id": "df-d3bfcf4ae2525daedaa3",
        "title": "Acceptance criteria are subjective and non-testable",
        "details": "Terms such as internally consistent, align, and no stale competing authority remains are not reduced to observable end-state assertions. The contract must specify the expected metadata surfaces, prohibited residue patterns, required authority references, and evidence that demonstrates each acceptance condition.",
        "path": null,
        "line": null
      },
      {
        "id": "df-66de9f0f82bc8ef34f60",
        "title": "Validation, failure handling, and rollout are missing",
        "details": "The issue provides no non-executing inspection plan for metadata and documentation coverage, no fail-closed behavior for ambiguous or conflicting artifacts, and no compatibility, migration, or rollout requirements for consumers of moved or retired metadata and documentation. The independent Validate gate does not supply this missing specification coverage.",
        "path": null,
        "line": null
      }
    ],
