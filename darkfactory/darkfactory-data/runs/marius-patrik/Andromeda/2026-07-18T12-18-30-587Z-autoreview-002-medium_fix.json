    "findings": [
      {
        "id": "df-003aed1dcd1630ae4e3e",
        "title": "Canonical Connect contract is not identified",
        "details": "The issue requires the canonical proto/Connect SwitcherService but does not identify the authoritative schema path, package/service version, required methods, request and response behavior, or compatibility target. An implementer cannot objectively determine what constitutes complete conformance.",
        "path": null,
        "line": null
      },
      {
        "id": "df-4166a8f7abace97d8089",
        "title": "Scope resolution and persistence semantics are underspecified",
        "details": "The stated session > project > global precedence does not define scope identifiers, inheritance versus explicit values, read and write behavior, deletion or reset semantics, storage ownership, concurrency and atomicity expectations, reload boundaries, or behavior when a scoped writer or stored state is unavailable or corrupt.",
        "path": null,
        "line": null
      },
      {
        "id": "df-4c5a31fe6ede19e01efd",
        "title": "Failure and trust boundaries are missing",
        "details": "The contract does not specify authentication or caller authority, validation boundaries for axes and options, error/status mappings for Connect and REST, handling of unavailable options, malformed input, persistence failures, partial writes, or safe behavior when registry and persisted state disagree.",
        "path": null,
        "line": null
      },
      {
        "id": "df-49322e1d93d8916f4a32",
        "title": "Dependencies and sequencing are not declared",
        "details": "The issue does not state whether open gateway work such as #210, #211, #213, or #214 is prerequisite, conflicting, or independent. In particular, registry canonicalization and gateway naming can determine protocol names, storage ownership, and implementation surfaces. The replacement relationship with closed #98 is stated, but no verified dependency contract or single-lane ownership boundary is provided.",
        "path": null,
        "line": null
      },
      {
        "id": "df-3fdf6891e1ed37c123dc",
        "title": "REST compatibility and rollout require an owner decision",
        "details": "“Keep REST endpoints as compatibility shims if needed” leaves product behavior to the worker. The owner must decide whether REST is retained, its supported routes and semantics, deprecation policy, compatibility duration, migration behavior, and whether any breaking change is permitted.",
        "path": null,
        "line": null
      },
      {
        "id": "df-ab582efe70c9f9c8432e",
        "title": "Acceptance and validation evidence are not objective enough",
        "details": "Acceptance does not enumerate observable protocol operations and expected results, required regression cases across all scopes and failure paths, authoritative test commands, documentation targets, or evidence proving persistence across process reload. It also omits rollout and rollback criteria. The required repository validation commands alone cannot establish behavioral conformance.",
        "path": null,
        "line": null
      }
    ],
