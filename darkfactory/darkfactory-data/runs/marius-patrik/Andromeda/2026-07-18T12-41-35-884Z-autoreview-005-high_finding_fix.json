    "findings": [
      {
        "id": "df-aae9578e03b645352252",
        "title": "Admission receipt requirements conflict with dependency ownership",
        "details": "Issue #213 says #275 exclusively owns the required verified receipt contract, but the supplied #275 contract defines an exact schema that lacks #213's credential-gate, billing-class, adapter, route-transition, observation, validation, and secret-scan fields. The specification does not state whether #275 must be changed or whether #213 owns a separate versioned admission record referencing the immutable #275 receipt. Implementation would therefore either duplicate another lane or be unable to satisfy #213 acceptance.",
        "path": null,
        "line": null
      },
      {
        "id": "df-b065d4cb61324f1dc4cc",
        "title": "Promotion and rollback criteria are not deterministically observable",
        "details": "Promotion requires a 24-hour observation window with no listed failures, but the contract does not define the observation source, required traffic or probes, window boundaries, evaluator, or whether an idle window can pass. Rollback on a repeated malformed response or timeout likewise has no count, time window, or reset rule. These omissions prevent objective testing and consistent route-state transitions.",
        "path": null,
        "line": null
      },
      {
        "id": "df-d117125d6914e8a00d6a",
        "title": "Canonical evidence destination and schema are unverifiable",
        "details": "The issue requires a schema-valid receipt in a Git-backed canonical evidence store and a marker-owned public comment, but identifies neither the repository and path nor an authoritative schema or marker format. A field list alone does not establish serialization, required-value constraints, canonical digest calculation, update identity, or validation ownership, so the publication and freshness acceptance criteria cannot be reproduced against an exact evidence reference.",
        "path": null,
        "line": null
      },
      {
        "id": "df-2d5e1701f3fb1a376b6b",
        "title": "Submodule pointer validation does not satisfy the repository overlay",
        "details": "The implementation lane targets canonical Agent OS runtime surfaces in a submodule-root repository, yet the contract neither forbids gitlink changes nor defines their admissible paths. The required recursive submodule-status command detects only part of the pointer state and does not prove child identity, configured URL, released default-branch ancestry, accessibility, or green required evidence. The issue must either exclude gitlink updates explicitly or require the complete trusted pointer contract for every changed gitlink.",
        "path": null,
        "line": null
      }
    ],
